[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://ui/flow.gd" id="1"]

[node name="Flow" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Editor" type="TextEdit" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
text = "import dsagame.api.*;

/** Attacks the first enemy every turn. */
public class Submission implements Strategy {
    public Action decide(GameState state) {
        return Action.attack(state.getEnemies().get(0));
    }
}
"

[node name="Bar" type="HBoxContainer" parent="VBox"]
layout_mode = 2

[node name="Submit" type="Button" parent="VBox/Bar"]
unique_name_in_owner = true
layout_mode = 2
text = "Submit"

[node name="Spinner" type="ProgressBar" parent="VBox/Bar"]
unique_name_in_owner = true
custom_minimum_size = Vector2(120, 0)
layout_mode = 2
size_flags_vertical = 4
show_percentage = false
indeterminate = true

[node name="Replay" type="HBoxContainer" parent="VBox/Bar"]
unique_name_in_owner = true
layout_mode = 2

[node name="Scenario" type="OptionButton" parent="VBox/Bar/Replay"]
unique_name_in_owner = true
layout_mode = 2

[node name="Step" type="Button" parent="VBox/Bar/Replay"]
unique_name_in_owner = true
layout_mode = 2
text = "Step"

[node name="Skip" type="Button" parent="VBox/Bar/Replay"]
unique_name_in_owner = true
layout_mode = 2
text = "Skip to end"

[node name="Reset" type="Button" parent="VBox/Bar/Replay"]
unique_name_in_owner = true
layout_mode = 2
text = "Reset"

[node name="Error" type="Label" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.4, 0.4, 1)
autowrap_mode = 3
